datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String    @id @default(uuid())
  name        String
  email       String    @unique
  role        String    @default("passenger")
  preferences String    
  bookings    Booking[]
}

model Booking {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  flightCode     String
  airline        String
  origin         String
  destination    String
  departureTime  String
  arrivalTime    String
  duration       String
  aircraft       String
  seat           String
  gate           String
  terminal       String
  boardingGroup  String
  totalPrice     Int
  currency       String
  currencySymbol String
  bookingRef     String
  date           String
  createdAt      DateTime @default(now())
}

